# ── Base de données ────────────────────────────────────────────────────────
# Développement local (SQLite) :
# DATABASE_URL="file:./dev.db"
# Production Docker (PostgreSQL) — défini automatiquement par docker-compose :
DATABASE_URL="postgresql://eternels:CHANGE_ME@localhost:5432/les_eternels"

# ── NextAuth ───────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"
NEXTAUTH_URL="http://localhost"          # URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL="http://localhost"  # Idem, accessible côté client

# ── Stripe (paiement en ligne) ─────────────────────────────────────────────
# Clés disponibles sur https://dashboard.stripe.com/apikeys
# Laisser vide pour désactiver le paiement en ligne (règlement sur place uniquement).
STRIPE_SECRET_KEY=""          # sk_test_... (test) ou sk_live_... (production)
# Secret du webhook (https://dashboard.stripe.com/webhooks) pointant vers
# https://votre-site/api/payments/webhook — événements : checkout.session.completed,
# checkout.session.expired. En dev : stripe listen --forward-to localhost:3001/api/payments/webhook
STRIPE_WEBHOOK_SECRET=""      # whsec_...

# ── SMTP (envoi de mails) ──────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="change-me"
SMTP_FROM="Les Éternels <user@example.com>"

# ── Docker Compose ─────────────────────────────────────────────────────────
POSTGRES_USER="eternels"
POSTGRES_PASSWORD="change-me-strong-password"
POSTGRES_DB="les_eternels"

# ── HTTPS / Let's Encrypt ───────────────────────────────────────────────────
DOMAIN="les-eternels.fr"             # Nom de domaine pointant vers ce VPS
CERTBOT_EMAIL="contact@les-eternels.fr"  # Email pour les alertes d'expiration
